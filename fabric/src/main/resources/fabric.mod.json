{
  "schemaVersion": 1,
  "id": "customtextureurl",
  "version": "${version}",
  "name": "CustomTextureURL",
  "description": "Allows loading textures from non-mojang domains.",
  "authors": [
    "KoishiMoe"
  ],
  "contact": {
    "homepage": "https://github.com/KoishiMoe/CustomTextureURL",
    "sources": "https://github.com/KoishiMoe/CustomTextureURL"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/customtextureurl/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.lolicode.customtextureurl.fabric.CustomTextureURLFabric"
    ]
  },
  "mixins": [
    "customtextureurl.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": ">=1.21.9",
    "java": ">=21"
  }
}
